{
  "projectName": "example-project",
  "ssh": {
    "host": "example.com",
    "port": 22,
    "username": "deploy",
    "password": "your-password-here",
    "_comment": "或者使用 privateKey 字段指定私钥文件路径"
  },
  "build": {
    "projectPath": "./project",
    "buildCommand": "npm run build",
    "outputDir": "dist"
  },
  "deploy": {
    "remotePath": "/var/www/example",
    "backup": true,
    "backupDir": "/var/www/backups"
  }
}